# =============================================================================
# CYBER AI - Example environment file
#
# Copy to `.env` and adjust. NEVER commit `.env`.
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows cmd)
#
# Naming: CYBERAI_<SECTION>__<FIELD>  (double underscore separates nesting)
# =============================================================================

# --- Runtime -----------------------------------------------------------------
CYBERAI_ENVIRONMENT=local
CYBERAI_DEBUG=true
CYBERAI_VERSION=0.1.0
CYBERAI_BUILD__COMMIT=unknown
CYBERAI_BUILD__TIME=unknown

# --- Application -------------------------------------------------------------
CYBERAI_APP__NAME=cyberai-api
CYBERAI_APP__CORS_ORIGINS=["http://localhost:3000"]
CYBERAI_APP__TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
CYBERAI_APP__EXPOSE_DOCS=true
CYBERAI_APP__MAX_REQUEST_BODY_BYTES=1048576
CYBERAI_APP__REQUEST_TIMEOUT_SECONDS=120

# --- Logging -----------------------------------------------------------------
# level: DEBUG | INFO | WARNING | ERROR
# format: console (human readable) | json (production)
CYBERAI_LOGGING__LEVEL=DEBUG
CYBERAI_LOGGING__FORMAT=console

# --- PostgreSQL --------------------------------------------------------------
# Host connection string used by the API process.
# Inside docker compose the host is `postgres`; from the host machine use `localhost`.
CYBERAI_DATABASE__URL=postgresql+asyncpg://cyberai:cyberai_dev_password@localhost:5432/cyberai
CYBERAI_DATABASE__POOL_SIZE=10
CYBERAI_DATABASE__MAX_OVERFLOW=5
CYBERAI_DATABASE__STATEMENT_TIMEOUT_MS=15000

# --- Redis -------------------------------------------------------------------
CYBERAI_REDIS__URL=redis://localhost:6379/0
CYBERAI_REDIS__MAX_CONNECTIONS=20

# --- Inference Gateway (HOW inference is reached) ----------------------------
CYBERAI_INFERENCE__REQUEST_TIMEOUT_SECONDS=60
CYBERAI_INFERENCE__FIRST_TOKEN_TIMEOUT_SECONDS=20
CYBERAI_INFERENCE__MAX_CONCURRENT_REQUESTS_PER_PROVIDER=8
CYBERAI_INFERENCE__CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CYBERAI_INFERENCE__CIRCUIT_BREAKER_RESET_SECONDS=30

# --- Model Gateway (WHICH model/provider is used) ----------------------------
CYBERAI_MODELS__DEFAULT_MODEL=mock-analyst-1
CYBERAI_MODELS__FALLBACK_MODELS=["mock-analyst-mini"]

# --- Mock provider (M0 only) -------------------------------------------------
# Artificial latency per streamed chunk, in milliseconds.
CYBERAI_MOCK__CHUNK_DELAY_MS=0
CYBERAI_MOCK__WORDS_PER_CHUNK=4

# --- Real provider (OpenAI-compatible; required for staging/production) -------
# Do not commit real keys. Set this through your deployment secret manager.
CYBERAI_OPENAI_COMPATIBLE__ENABLED=false
CYBERAI_OPENAI_COMPATIBLE__API_KEY=
CYBERAI_OPENAI_COMPATIBLE__BASE_URL=https://api.openai.com/v1
CYBERAI_OPENAI_COMPATIBLE__MODEL=gpt-4o-mini
CYBERAI_OPENAI_COMPATIBLE__MODEL_KEY=openai-compatible-chat
CYBERAI_OPENAI_COMPATIBLE__DISPLAY_NAME=OpenAI-Compatible Chat

# --- Billing / usage limits --------------------------------------------------
CYBERAI_BILLING__ENABLED=true
CYBERAI_BILLING__RATE_LIMIT_FAIL_OPEN=true
CYBERAI_BILLING__USER_RATE_LIMIT_ENABLED=false

# --- Security policy ----------------------------------------------------------
CYBERAI_POLICY__ENABLED=true
CYBERAI_POLICY__PROFILE=default
CYBERAI_POLICY__ABUSE_THRESHOLD=5
CYBERAI_POLICY__ABUSE_WINDOW_SECONDS=300

# --- Auth --------------------------------------------------------------------
# Local-only default. Production/staging must provide a high-entropy secret.
CYBERAI_AUTH__JWT_SECRET=cyberai_dev_jwt_secret_do_not_use_in_prod

# =============================================================================
# Docker Compose only (consumed by the postgres/redis containers, not the app)
# =============================================================================
POSTGRES_USER=cyberai
POSTGRES_PASSWORD=cyberai_dev_password
POSTGRES_DB=cyberai
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=3000

# --- Frontend ----------------------------------------------------------------
# Public: exposed to the browser. NEVER put provider API keys in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
