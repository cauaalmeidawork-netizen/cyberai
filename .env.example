# =============================================================================
# NOMERCY AI - Example environment file
#
# Copy to `.env` and adjust. NEVER commit `.env`.
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows cmd)
#
# Naming: NOMERCY_<SECTION>__<FIELD>  (double underscore separates nesting)
#
# The service was formerly branded "CyberAI". The deprecated `CYBERAI_*`
# prefix is still read as a fallback for existing deployments; `NOMERCY_*`
# always wins when both are present.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NOMERCY_ENVIRONMENT=local
NOMERCY_DEBUG=true
NOMERCY_VERSION=0.1.0
NOMERCY_BUILD__COMMIT=unknown
NOMERCY_BUILD__TIME=unknown

# --- Application -------------------------------------------------------------
NOMERCY_APP__NAME=nomercy-api
NOMERCY_APP__CORS_ORIGINS=["http://localhost:3000"]
NOMERCY_APP__TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
NOMERCY_APP__EXPOSE_DOCS=true
NOMERCY_APP__MAX_REQUEST_BODY_BYTES=1048576
NOMERCY_APP__REQUEST_TIMEOUT_SECONDS=120

# --- Logging -----------------------------------------------------------------
# level: DEBUG | INFO | WARNING | ERROR
# format: console (human readable) | json (production)
NOMERCY_LOGGING__LEVEL=DEBUG
NOMERCY_LOGGING__FORMAT=console

# --- PostgreSQL --------------------------------------------------------------
# Host connection string used by the API process.
# Inside docker compose the host is `postgres`; from the host machine use `localhost`.
NOMERCY_DATABASE__URL=postgresql+asyncpg://cyberai:cyberai_dev_password@localhost:5432/cyberai
NOMERCY_DATABASE__POOL_SIZE=10
NOMERCY_DATABASE__MAX_OVERFLOW=5
NOMERCY_DATABASE__STATEMENT_TIMEOUT_MS=15000

# --- Redis -------------------------------------------------------------------
NOMERCY_REDIS__URL=redis://127.0.0.1:6379/0
NOMERCY_REDIS__SOCKET_TIMEOUT_SECONDS=0.25
NOMERCY_REDIS__SOCKET_CONNECT_TIMEOUT_SECONDS=0.25
NOMERCY_REDIS__MAX_CONNECTIONS=20

# --- Inference Gateway (HOW inference is reached) ----------------------------
NOMERCY_INFERENCE__REQUEST_TIMEOUT_SECONDS=60
NOMERCY_INFERENCE__FIRST_TOKEN_TIMEOUT_SECONDS=20
NOMERCY_INFERENCE__MAX_CONCURRENT_REQUESTS_PER_PROVIDER=8
NOMERCY_INFERENCE__CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
NOMERCY_INFERENCE__CIRCUIT_BREAKER_RESET_SECONDS=30

# --- Model Gateway (WHICH model/provider is used) ----------------------------
NOMERCY_MODELS__DEFAULT_MODEL=openai-compatible-chat
NOMERCY_MODELS__FALLBACK_MODELS=[]

# --- Mock provider (development only) ----------------------------------------
# Artificial latency per streamed chunk, in milliseconds.
NOMERCY_MOCK__CHUNK_DELAY_MS=0
NOMERCY_MOCK__WORDS_PER_CHUNK=4

# --- Real provider (OpenAI-compatible; local default is Ollama) ---------------
# Local development uses Ollama's OpenAI-compatible API with a dummy key.
# Do not commit real vendor keys. Set paid provider keys through secret manager.
NOMERCY_OPENAI_COMPATIBLE__ENABLED=true
NOMERCY_OPENAI_COMPATIBLE__API_KEY=ollama
NOMERCY_OPENAI_COMPATIBLE__BASE_URL=http://localhost:11434/v1
NOMERCY_OPENAI_COMPATIBLE__MODEL=qwen2.5:3b
NOMERCY_OPENAI_COMPATIBLE__MODEL_KEY=openai-compatible-chat
NOMERCY_OPENAI_COMPATIBLE__DISPLAY_NAME=Qwen 2.5 3B Local
NOMERCY_OPENAI_COMPATIBLE__KEEP_ALIVE=30m

# --- Web research (optional; every provider is independent) -------------------
# The app works with any subset configured. Without keys, research falls back
# to the keyless authoritative security sources (NVD, CISA KEV, OSV, GHSA).
NOMERCY_RESEARCH__ENABLED=false
NOMERCY_RESEARCH__PRIMARY_PROVIDER=
NOMERCY_RESEARCH__BRAVE_API_KEY=
NOMERCY_RESEARCH__EXA_API_KEY=
NOMERCY_RESEARCH__FIRECRAWL_API_KEY=
NOMERCY_RESEARCH__TAVILY_API_KEY=
NOMERCY_RESEARCH__MAX_SOURCES=6
NOMERCY_RESEARCH__REQUEST_TIMEOUT_SECONDS=15
NOMERCY_RESEARCH__CACHE_TTL_SECONDS=900

# --- Billing / usage limits --------------------------------------------------
NOMERCY_BILLING__ENABLED=true
NOMERCY_BILLING__PROVIDER=none
NOMERCY_BILLING__RATE_LIMIT_FAIL_OPEN=true
NOMERCY_BILLING__USER_RATE_LIMIT_ENABLED=false
NOMERCY_BILLING__STRIPE_SECRET_KEY=
NOMERCY_BILLING__STRIPE_WEBHOOK_SECRET=
NOMERCY_BILLING__STRIPE_PRICE_IDS={}
NOMERCY_BILLING__CHECKOUT_SUCCESS_URL=http://localhost:3000
NOMERCY_BILLING__CHECKOUT_CANCEL_URL=http://localhost:3000
NOMERCY_BILLING__PORTAL_RETURN_URL=http://localhost:3000

# --- Security policy ----------------------------------------------------------
NOMERCY_POLICY__ENABLED=true
NOMERCY_POLICY__PROFILE=default
NOMERCY_POLICY__ABUSE_THRESHOLD=5
NOMERCY_POLICY__ABUSE_WINDOW_SECONDS=300

# --- Auth --------------------------------------------------------------------
# Legacy Bearer is local/CI only. Production/staging must set it to false and
# configure OIDC + opaque server-side sessions.
NOMERCY_AUTH__JWT_SECRET=cyberai_dev_jwt_secret_do_not_use_in_prod
NOMERCY_AUTH__LEGACY_BEARER_ENABLED=true
NOMERCY_AUTH__OIDC_ENABLED=false
NOMERCY_AUTH__OIDC_AUTO_PROVISION_ENABLED=false
NOMERCY_AUTH__OIDC_ISSUER=
NOMERCY_AUTH__OIDC_CLIENT_ID=
NOMERCY_AUTH__OIDC_CLIENT_SECRET=
NOMERCY_AUTH__OIDC_REDIRECT_URI=http://localhost:8001/api/v1/auth/callback
NOMERCY_AUTH__OIDC_SCOPE="openid email profile"
NOMERCY_AUTH__SESSION_COOKIE_NAME=cyberai_session
NOMERCY_AUTH__CSRF_HEADER_NAME=X-CSRF-Token
NOMERCY_AUTH__SESSION_TTL_SECONDS=28800
NOMERCY_AUTH__SESSION_SECURE_COOKIE=false
NOMERCY_AUTH__SESSION_SAMESITE=lax
NOMERCY_AUTH__SESSION_SECRET=
NOMERCY_AUTH__CSRF_SECRET=

# =============================================================================
# Docker Compose only (consumed by the postgres/redis containers, not the app)
# =============================================================================
POSTGRES_USER=cyberai
POSTGRES_PASSWORD=cyberai_dev_password
POSTGRES_DB=cyberai
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8001
WEB_PORT=3000

# --- Frontend ----------------------------------------------------------------
# Public: exposed to the browser. NEVER put provider API keys in NEXT_PUBLIC_*.
# In local development the browser talks to Next.js same-origin /api/*.
NEXT_PUBLIC_API_BASE_URL=
API_PROXY_TARGET=http://localhost:8001
