# =============================================================================
# CYBER AI - Example environment file
#
# Copy to `.env` and adjust. NEVER commit `.env`.
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows cmd)
#
# Naming: CYBERAI_<SECTION>__<FIELD>  (double underscore separates nesting)
# =============================================================================

# --- Runtime -----------------------------------------------------------------
CYBERAI_ENVIRONMENT=local
CYBERAI_DEBUG=true

# --- Application -------------------------------------------------------------
CYBERAI_APP__NAME=cyberai-api
CYBERAI_APP__CORS_ORIGINS=["http://localhost:3000"]

# --- Logging -----------------------------------------------------------------
# level: DEBUG | INFO | WARNING | ERROR
# format: console (human readable) | json (production)
CYBERAI_LOGGING__LEVEL=DEBUG
CYBERAI_LOGGING__FORMAT=console

# --- PostgreSQL --------------------------------------------------------------
# Host connection string used by the API process.
# Inside docker compose the host is `postgres`; from the host machine use `localhost`.
CYBERAI_DATABASE__URL=postgresql+asyncpg://cyberai:cyberai_dev_password@localhost:5432/cyberai
CYBERAI_DATABASE__POOL_SIZE=10

# --- Redis -------------------------------------------------------------------
CYBERAI_REDIS__URL=redis://localhost:6379/0

# --- Inference Gateway (HOW inference is reached) ----------------------------
CYBERAI_INFERENCE__REQUEST_TIMEOUT_SECONDS=60
CYBERAI_INFERENCE__MAX_CONCURRENT_REQUESTS_PER_PROVIDER=8
CYBERAI_INFERENCE__CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CYBERAI_INFERENCE__CIRCUIT_BREAKER_RESET_SECONDS=30

# --- Model Gateway (WHICH model/provider is used) ----------------------------
CYBERAI_MODELS__DEFAULT_MODEL=mock-analyst-1
CYBERAI_MODELS__FALLBACK_MODELS=["mock-analyst-mini"]

# --- Mock provider (M0 only) -------------------------------------------------
# Artificial latency per streamed chunk, in milliseconds.
CYBERAI_MOCK__CHUNK_DELAY_MS=0

# =============================================================================
# Docker Compose only (consumed by the postgres/redis containers, not the app)
# =============================================================================
POSTGRES_USER=cyberai
POSTGRES_PASSWORD=cyberai_dev_password
POSTGRES_DB=cyberai
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=3000

# --- Frontend ----------------------------------------------------------------
# Public: exposed to the browser. NEVER put provider API keys in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
